generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String        @id
  name         String
  email        String        @unique
  password     String
  role         String
  createdAt    DateTime
  sessions     Session[]
  cropListings CropListing[]
  auctions     Auction[]
  bids         Bid[]
  notifications Notification[]
}

model Session {
  id        String   @id
  userId    String
  expires   DateTime
  createdAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

model CropListing {
  id            String     @id @default(uuid())
  farmerId      String
  cropName      String
  category      String
  description   String?
  
  // Whole-lot mandi model fields
  quantityKg    Int        // Internal: always in KG (e.g., 5000)
  expectedPricePerQuintal Decimal?  // Auction bid price per quintal
  
  // Display fields (backward compatible)
  quantity      String     // Display: "5,000 kg"
  unit          String     // Display: "kg"
  
  // Lot lifecycle
  lotStatus     String     @default("DRAFT")  // DRAFT, SUBMITTED_FOR_INSPECTION, INSPECTION_IN_PROGRESS, QUALITY_VERIFIED, AUCTION_READY, AUCTION_ACTIVE, AUCTION_CLOSED, SOLD, REJECTED, CANCELLED
  inspectionStatus String   @default("PENDING") // PENDING, IN_PROGRESS, APPROVED, REJECTED, REINSPECTION_REQUIRED
  aiAssessmentStatus String @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  
  // Lot metadata
  location      String
  harvestDate   DateTime?
  expectedPrice Decimal?
  
  farmer        User      @relation(fields: [farmerId], references: [id])
  auctions      Auction[]
}

model Auction {
  id               String     @id @default(uuid())
  cropListingId    String
  startingPrice    Decimal
  minimumIncrement Decimal
  status           String     @default("ACTIVE")
  startsAt         DateTime
  endsAt           DateTime
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  cropListing      CropListing @relation(fields: [cropListingId], references: [id])
  bids             Bid[]
  user             User?      @relation(fields: [userId], references: [id])
  userId           String?
}

model Bid {
  id        String   @id @default(uuid())
  auctionId String
  buyerId   String
  amount    Decimal  // bidPricePerQuintal (₹/quintal)
  createdAt DateTime @default(now())
  auction   Auction  @relation(fields: [auctionId], references: [id])
  buyer     User     @relation(fields: [buyerId], references: [id])
}

model Payment {
  id               String     @id @default(uuid())
  orderId          String     @unique
  razorpayOrderId  String
  razorpayPaymentId String
  razorpaySignature String
  amount           Decimal
  currency         String     @default("INR")
  status           String     @default("CREATED")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Notification {
  id          String     @id @default(uuid())
  userId      String
  type        String
  title       String
  message     String
  read        Boolean    @default(false)
  relatedEntityType String?
  relatedEntityId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id])
}

model CropQualityAssessment {
  id              String     @id @default(uuid())
  cropListingId   String     @unique
  score           Int
  grade           String
  issues          Json
  observations    String
  confidence      Int
  provider        String
  model           String
  status          String     @default("PENDING")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// New: Delivery model for logistics tracking
model Delivery {
  id              String     @id @default(uuid())
  orderId         String     @unique
  status          String     @default("CREATED")
  trackingNumber  String?    @db.VarChar(100)
  deliveryPartner String?    @db.VarChar(100)
  estimatedDeliveryDate DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// New: DeliveryEvent for tracking history
model DeliveryEvent {
  id              String     @id @default(uuid())
  deliveryId      String
  status          String
  title           String
  description     String?
  location        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}
