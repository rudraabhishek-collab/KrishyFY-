generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id      String   @id
  name    String
  email   String  @unique
  password String
  role    String
  createdAt DateTime
  sessions Session[]
  cropListings CropListing[]
}

model Session {
  id        String   @id
  userId    String
  expires   DateTime
  createdAt DateTime
  user      User @relation(fields: [userId], references: [id])
}

model CropListing {
  id        String   @id @default(uuid())
  farmerId  String
  cropName  String
  category  String
  description String?
  quantity  String
  unit      String
  expectedPrice  Decimal?
  location  String
  harvestDate DateTime?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  farmer    User     @relation(fields: [farmerId], references: [id])
}